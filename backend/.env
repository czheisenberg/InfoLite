# ===================== 数据库配置 =====================
# MySQL配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PWD=infolite@123
MYSQL_DB=infolite_db
# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PWD=infolite@Redis123
# ES配置
ES_HOST=127.0.0.1
ES_PORT=9200
# 扫描配置（安全限制）
MAX_CONCURRENT=50
SCAN_DELAY=0.5

# ===================== 扫描安全配置 =====================
# IP白名单开关（true=启用白名单限制，false=关闭白名单限制）
ENABLE_IP_WHITELIST=false
# IP白名单（仅允许扫描本地/内网/合法靶场，核心安全限制）
ALLOWED_IP_PREFIX=127.0.0.1,192.168.1.10,39.156.70.239,8.8.8.8,192.168.1.16,172.66.147.243
# 扫描配置（Windows本地限定低并发，避免端口耗尽/限流）
MAX_CONCURRENT=50        # 最大并发数
SCAN_TIMEOUT=3           # 端口探测超时时间（秒）
COMMON_PORTS=80,443,22,3389,8080,8090,9090,5173,8000,8888  # 常用扫描端口
SCAN_EXPIRE_TIME=86400   # 扫描有效期（秒），24(86400秒)小时内直接查数据库
# Nmap配置
NMAP_PATH="C:\\Program Files (x86)\\Nmap\\nmap.exe"        # Nmap可执行文件路径，Windows下如 C:\\Program Files (x86)\\Nmap\\nmap.exe

# ===================== API配置 =====================
API_HOST=127.0.0.1       # 仅本地访问，不对外暴露
API_PORT=8000            # API端口